
local function SafeParent(gui)
    local ok = pcall(function() gui.Parent = CoreGui end)
    if not ok or not gui.Parent then
        local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
        if pg then gui.Parent = pg end
    end
end
